"""
Analytics service build configuration
gRPC service querying ClickHouse for metrics aggregation
"""

# ============================================================================
# Gazelle Configuration for Analytics service
# ============================================================================
# gazelle:resolve proto go github.com/opisvigilant/futura/proto //proto:futura_go_proto

load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Go library
go_library(
    name = "analytics_lib",
    srcs = ["main.go"],
    importpath = "github.com/opisvigilant/futura/analytics",
    visibility = ["//visibility:private"],
    deps = [
        "//analytics/internal/config",
        "//analytics/internal/server",
        "//proto/gen/analytics",
        "@com_github_fsnotify_fsnotify//:fsnotify",
        "@com_github_rs_zerolog//:zerolog",
        "@com_github_rs_zerolog//log",
        "@com_github_spf13_viper//:viper",
        "@org_golang_google_grpc//:grpc",
    ],
)

# Binary
go_binary(
    name = "analytics",
    embed = [":analytics_lib"],
    visibility = ["//visibility:public"],
)

# Package binary for containerization
pkg_tar(
    name = "analytics_tar",
    srcs = [":analytics"],
    mode = "0755",
    package_dir = "/app",
)

# Package config file
pkg_tar(
    name = "config_tar",
    srcs = ["config.toml"],
    mode = "0644",
    package_dir = "/app",
)

# OCI image (linux/amd64)
oci_image(
    name = "analytics_image_amd64",
    base = "@distroless_base",
    entrypoint = ["/app/analytics"],
    exposed_ports = ["50051/tcp"],
    tars = [
        ":analytics_tar",
        ":config_tar",
    ],
    workdir = "/app",
)

# OCI image (linux/arm64)
oci_image(
    name = "analytics_image_arm64",
    base = "@distroless_base",
    entrypoint = ["/app/analytics"],
    exposed_ports = ["50051/tcp"],
    tars = [
        ":analytics_tar",
        ":config_tar",
    ],
    workdir = "/app",
)

# Multi-platform image index
oci_image_index(
    name = "analytics_image",
    images = [
        ":analytics_image_amd64",
        ":analytics_image_arm64",
    ],
    visibility = ["//visibility:public"],
)

# Push to Docker Hub
oci_push(
    name = "push",
    image = ":analytics_image",
    repository = "docker.io/davideberdin/futura-analytics",
    tags = ["latest"],
)
