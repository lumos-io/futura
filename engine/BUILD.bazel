"""
Engine build configuration
ML-powered Kubernetes optimization engine (Python)
Uses existing Dockerfile due to UV package manager complexity
"""

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Build using existing Dockerfile (UV package manager is complex for Bazel)
# This orchestrates the multi-stage Docker build
genrule(
    name = "engine_docker_build",
    srcs = glob([
        "**/*.py",
        "pyproject.toml",
        "uv.lock",
        "config.toml",
        "Dockerfile",
    ]),
    outs = [
        ".venv.tar",
        "app_files.tar",
    ],
    cmd = """
        # Copy source to temp directory
        TEMP_DIR=$$(mktemp -d)
        cp -r $$(dirname $(location Dockerfile))/* $$TEMP_DIR/

        # Build using Docker (builder stage only to extract venv)
        cd $$TEMP_DIR
        docker build \
            --target builder \
            --platform linux/amd64 \
            -t engine-builder:temp \
            -f Dockerfile \
            .

        # Extract .venv and app files
        docker create --name engine-temp engine-builder:temp
        docker cp engine-temp:/app/.venv - > $(location .venv.tar)
        docker cp engine-temp:/app/. - > $(location app_files.tar)
        docker rm engine-temp
        docker rmi engine-builder:temp

        # Cleanup
        rm -rf $$TEMP_DIR
    """,
    tags = [
        "local",
        "requires-docker",
    ],
)

# Package virtual environment
pkg_tar(
    name = "venv_tar",
    srcs = [":engine_docker_build"],
    mode = "0755",
    package_dir = "/app/.venv",
)

# Package application files
pkg_tar(
    name = "app_tar",
    srcs = [":engine_docker_build"],
    mode = "0644",
    package_dir = "/app",
)

# Package config file
pkg_tar(
    name = "config_tar",
    srcs = ["config.toml"],
    mode = "0644",
    package_dir = "/app",
)

# Create logs and data directories
genrule(
    name = "create_dirs",
    outs = [
        "logs",
        "data",
    ],
    cmd = """
        mkdir -p $(location logs)
        mkdir -p $(location data)
    """,
)

pkg_tar(
    name = "dirs_tar",
    srcs = [":create_dirs"],
    mode = "0755",
    package_dir = "/app",
)

# OCI image (linux/amd64)
oci_image(
    name = "engine_image_amd64",
    base = "@python_base",
    cmd = [
        "uv",
        "run",
        "main.py",
        "--config",
        "config.toml",
    ],
    env = {
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PATH": "/app/.venv/bin:$$PATH",
    },
    exposed_ports = ["8080/tcp"],
    tars = [
        ":venv_tar",
        ":app_tar",
        ":config_tar",
        ":dirs_tar",
    ],
    user = "app:app",
    workdir = "/app",
)

# OCI image (linux/arm64)
oci_image(
    name = "engine_image_arm64",
    base = "@python_base",
    cmd = [
        "uv",
        "run",
        "main.py",
        "--config",
        "config.toml",
    ],
    env = {
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PATH": "/app/.venv/bin:$$PATH",
    },
    exposed_ports = ["8080/tcp"],
    tars = [
        ":venv_tar",
        ":app_tar",
        ":config_tar",
        ":dirs_tar",
    ],
    user = "app:app",
    workdir = "/app",
)

# Multi-platform image index
oci_image_index(
    name = "engine_image",
    images = [
        ":engine_image_amd64",
        ":engine_image_arm64",
    ],
    visibility = ["//visibility:public"],
)

# Push to Docker Hub
oci_push(
    name = "push",
    image = ":engine_image",
    repository = "docker.io/davideberdin/futura-engine",
    tags = ["latest"],
)
