"""
Pipeline build configuration
Single Go binary with multiple subcommands (collect, validate, enrich, store)
Deployed as separate K8s deployments with different args
"""

# ============================================================================
# Gazelle Configuration for Pipeline service
# ============================================================================
# gazelle:resolve proto go github.com/opisvigilant/futura/proto //proto:futura_go_proto

load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Go library
go_library(
    name = "pipeline_lib",
    srcs = ["main.go"],
    importpath = "github.com/opisvigilant/futura/pipeline",
    visibility = ["//visibility:private"],
    deps = [
        "//pipeline/cmd",
    ],
)

# Binary
go_binary(
    name = "pipeline",
    embed = [":pipeline_lib"],
    visibility = ["//visibility:public"],
)

# Package binary for containerization
pkg_tar(
    name = "pipeline_tar",
    srcs = [":pipeline"],
    mode = "0755",
    package_dir = "/app",
)

# Package config file
pkg_tar(
    name = "config_tar",
    srcs = ["config.toml"],
    mode = "0644",
    package_dir = "/app",
)

# OCI image (linux/amd64)
oci_image(
    name = "pipeline_image_amd64",
    base = "@distroless_base",
    entrypoint = ["/app/pipeline"],
    tars = [
        ":pipeline_tar",
        ":config_tar",
    ],
    workdir = "/app",
)

# OCI image (linux/arm64)
oci_image(
    name = "pipeline_image_arm64",
    base = "@distroless_base",
    entrypoint = ["/app/pipeline"],
    tars = [
        ":pipeline_tar",
        ":config_tar",
    ],
    workdir = "/app",
)

# Multi-platform image index
oci_image_index(
    name = "pipeline_image",
    images = [
        ":pipeline_image_amd64",
        ":pipeline_image_arm64",
    ],
    visibility = ["//visibility:public"],
)

# Push to Docker Hub
# Note: Same image used for all 4 services (collect, validate, enrich, store)
# Different K8s deployments use different command args
oci_push(
    name = "push",
    image = ":pipeline_image",
    repository = "docker.io/davideberdin/futura-pipeline",
    tags = ["latest"],
)
