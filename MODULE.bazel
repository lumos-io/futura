"""
Futura monorepo - Bazel MODULE configuration (Bzlmod)
Bazel 8.4+ with modern dependency management
"""

module(
    name = "futura",
    version = "0.1.0",
    repo_name = "futura",
)

# Go toolchain and build rules
bazel_dep(name = "rules_go", version = "0.50.1")
bazel_dep(name = "gazelle", version = "0.39.1")

# OCI/Docker image building (replaces deprecated rules_docker)
bazel_dep(name = "rules_oci", version = "2.0.0")

# JavaScript/TypeScript tooling for frontend
bazel_dep(name = "aspect_rules_js", version = "2.1.0")
bazel_dep(name = "aspect_rules_ts", version = "3.2.1")

# Python tooling for engine
bazel_dep(name = "rules_python", version = "0.36.0")

# Packaging utilities
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "aspect_bazel_lib", version = "2.21.2")

# ============================================================================
# Go SDK and Dependencies
# ============================================================================

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.2")
use_repo(go_sdk, "go_toolchains")

# Import Go dependencies from go.work at repository root
# This supports monorepo with multiple Go modules
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_work = "//:go.work")

# Register all Go dependencies
# Auto-populated by: bazel run //:gazelle-update-repos
use_repo(
    go_deps,
    "com_github_alicebob_miniredis_v2",
    "com_github_aws_aws_sdk_go_v2",
    "com_github_aws_aws_sdk_go_v2_config",
    "com_github_aws_aws_sdk_go_v2_credentials",
    "com_github_aws_aws_sdk_go_v2_service_eks",
    "com_github_cilium_ebpf",
    "com_github_clickhouse_clickhouse_go_v2",
    "com_github_distribution_reference",
    "com_github_fsnotify_fsnotify",
    "com_github_gin_contrib_sessions",
    "com_github_gin_contrib_static",
    "com_github_gin_gonic_gin",
    "com_github_golang_jwt_jwt_v5",
    "com_github_google_uuid",
    "com_github_ibm_sarama",
    "com_github_jackc_pgx_v5",
    "com_github_onsi_ginkgo_v2",
    "com_github_onsi_gomega",
    "com_github_openshift_api",
    "com_github_openshift_client_go",
    "com_github_opisvigilant_futura_go_lib",
    "com_github_opisvigilant_futura_proto",
    "com_github_redis_go_redis_v9",
    "com_github_riverqueue_river",
    "com_github_riverqueue_river_riverdriver_riverpgxv5",
    "com_github_rs_zerolog",
    "com_github_spf13_cobra",
    "com_github_spf13_viper",
    "com_github_stretchr_testify",
    "com_github_unleash_unleash_client_go_v4",
    "io_gorm_datatypes",
    "io_gorm_driver_postgres",
    "io_gorm_driver_sqlite",
    "io_gorm_gorm",
    "io_k8s_api",
    "io_k8s_apimachinery",
    "io_k8s_autoscaler_vertical_pod_autoscaler",
    "io_k8s_client_go",
    "io_k8s_kubelet",
    "io_k8s_sigs_controller_runtime",
    "io_k8s_utils",
    "io_opentelemetry_go_otel",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_oauth2",
    # Dependencies will be listed here after running gazelle-update-repos
    # DO NOT EDIT MANUALLY - use 'bazel run //:gazelle-update-repos'
)

# ============================================================================
# Node.js and Bun toolchains for frontend
# ============================================================================

node = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
node.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//frontend:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(node, "npm")

# ============================================================================
# Python toolchain for engine
# ============================================================================

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    configure_coverage_tool = True,
    python_version = "3.13",
)

# ============================================================================
# OCI base images for containerization
# ============================================================================

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# Distroless base images (for Go services)
# Using :latest tag for multi-platform support
oci.pull(
    name = "distroless_base",
    image = "gcr.io/distroless/base-debian12:latest",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
oci.pull(
    name = "distroless_static",
    image = "gcr.io/distroless/static-debian12:latest",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)

# Python slim image (for engine)
oci.pull(
    name = "python_base",
    image = "python:3.13-slim",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)

# Debian bookworm (for watcher eBPF compilation)
oci.pull(
    name = "debian_bookworm",
    image = "debian:bookworm",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(oci, "debian_bookworm", "debian_bookworm_linux_amd64", "debian_bookworm_linux_arm64_v8", "distroless_base", "distroless_base_linux_amd64", "distroless_base_linux_arm64_v8", "distroless_static", "distroless_static_linux_amd64", "distroless_static_linux_arm64_v8", "python_base", "python_base_linux_amd64", "python_base_linux_arm64_v8")
