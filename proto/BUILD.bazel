"""
Proto definitions for Futura services
Protocol Buffer files for cross-service communication
"""

# ============================================================================
# Gazelle Configuration for proto
# ============================================================================
# gazelle:proto disable

# Proto files are managed via Makefile (make proto-files)
# This BUILD file exists only to satisfy Bazel module requirements

filegroup(
    name = "proto_files",
    srcs = glob(
        ["*.proto"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# Go proto outputs (generated by make proto-go)
filegroup(
    name = "futura_go_proto",
    srcs = glob(
        [
            "*.pb.go",
            "*_grpc.pb.go",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
