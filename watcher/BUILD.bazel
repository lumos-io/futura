load("@rules_go//go:def.bzl", "go_binary", "go_library")

"""
Watcher build configuration
eBPF-based Kubernetes event watcher deployed as DaemonSet
Uses existing Dockerfile due to complex eBPF compilation requirements
"""

# ============================================================================
# Gazelle Configuration for Watcher service
# ============================================================================
# gazelle:exclude internal/ebpf/bpf
# gazelle:exclude *.c
# gazelle:exclude *.h
# gazelle:resolve proto go github.com/opisvigilant/futura/proto //proto:futura_go_proto

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Build using existing Dockerfile (too complex for native Bazel)
# This uses docker_build from rules_oci to orchestrate the multi-stage build
genrule(
    name = "watcher_docker_build",
    srcs = glob(
        [
            "**/*.go",
            "**/*.c",
            "**/*.h",
            "go.mod",
            "go.sum",
            "Makefile",
            "Dockerfile",
        ],
        allow_empty = True,
    ) + [
        "//proto:proto_files",
    ],
    outs = [
        "bin/watcher",
        "bpf_objects",
    ],
    cmd = """
        # Copy source to temp directory
        TEMP_DIR=$$(mktemp -d)
        cp -r $$(dirname $(location Dockerfile))/* $$TEMP_DIR/
        cp -r $(location //proto:proto_files) $$TEMP_DIR/../proto/

        # Build using Docker
        cd $$TEMP_DIR
        docker build \
            --target builder \
            --platform linux/amd64 \
            -t watcher-builder:temp \
            -f Dockerfile \
            ..

        # Extract artifacts
        docker create --name watcher-temp watcher-builder:temp
        docker cp watcher-temp:/src/bin/watcher $(location bin/watcher)
        docker cp watcher-temp:/src/internal/ebpf/bpf/. $(location bpf_objects)
        docker rm watcher-temp
        docker rmi watcher-builder:temp

        # Cleanup
        rm -rf $$TEMP_DIR
    """,
    tags = [
        "local",
        "requires-docker",
    ],
)

# Package watcher binary
pkg_tar(
    name = "watcher_tar",
    srcs = [":watcher_docker_build"],
    mode = "0755",
    package_dir = "/bin",
)

# Package eBPF objects
pkg_tar(
    name = "bpf_tar",
    srcs = [":watcher_docker_build"],
    mode = "0644",
    package_dir = "/bpf",
)

# OCI image (linux/amd64)
# Watcher requires kernel features, primarily built for amd64
oci_image(
    name = "watcher_image_amd64",
    base = "@distroless_base",
    entrypoint = ["/bin/watcher"],
    tars = [
        ":watcher_tar",
        ":bpf_tar",
    ],
    workdir = "/",
)

# OCI image (linux/arm64)
oci_image(
    name = "watcher_image_arm64",
    base = "@distroless_base",
    entrypoint = ["/bin/watcher"],
    tars = [
        ":watcher_tar",
        ":bpf_tar",
    ],
    workdir = "/",
)

# Multi-platform image index
oci_image_index(
    name = "watcher_image",
    images = [
        ":watcher_image_amd64",
        ":watcher_image_arm64",
    ],
    visibility = ["//visibility:public"],
)

# Push to Docker Hub
oci_push(
    name = "push",
    image = ":watcher_image",
    repository = "docker.io/davideberdin/futura-watcher",
    tags = ["latest"],
)

go_library(
    name = "watcher_lib",
    srcs = ["main.go"],
    importpath = "github.com/opisvigilant/futura/watcher",
    visibility = ["//visibility:private"],
    deps = [
        "//watcher/internal/collector",
        "//watcher/internal/config",
        "@com_github_fsnotify_fsnotify//:fsnotify",
        "@com_github_rs_zerolog//:zerolog",
        "@com_github_rs_zerolog//log",
        "@com_github_spf13_viper//:viper",
    ],
)

go_binary(
    name = "watcher",
    embed = [":watcher_lib"],
    visibility = ["//visibility:public"],
)
